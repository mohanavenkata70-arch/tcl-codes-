proc sum {num} {
    set arm $num
    set temp 0
    while {$num > 0} {
        set digit   [expr {$num % 10}]
        set temp [expr { $temp  +  ( $digit * $digit * $digit )}]
        set num     [expr {$num / 10}]
    }
    if {$arm == $temp} {
        puts "$arm is an armstrong number"
    } else {
        puts "$arm is not a armstrong number "
    }
}

sum 153
